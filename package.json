{
  "name": "ecom-fabric",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ECOM-FABRIC GERMANY – teilautonome E-Commerce-Fabrik",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p apps/worker && npm run typecheck -w @ecom-fabric/dashboard",
    "ue": "tsx scripts/unit-economics.ts",
    "dev:dashboard": "npm run dev -w @ecom-fabric/dashboard",
    "dev:worker": "npm run dev -w @ecom-fabric/worker",
    "build": "npm run build -w @ecom-fabric/dashboard",
    "check:supabase": "tsx --env-file-if-exists=.env.local scripts/check-supabase.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:setup-worker": "tsx --env-file-if-exists=.env.local scripts/db-setup-worker-role.ts",
    "fabric": "tsx --env-file-if-exists=.env.local scripts/fabric.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:add-operator": "tsx --env-file-if-exists=.env.local scripts/db-add-operator.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
