# Vorlage. Kopie als .env.local im Projektstamm anlegen und selbst befüllen. Niemals committen.
# Dashboard und Worker lesen beide die .env.local im Projektstamm.

# Umgebung: dev | prod
FABRIC_ENV=dev

# Supabase (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable Key (sb_publishable_...), browsertauglich, Schutz über RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nur serverseitig (Worker / Server Actions), nie mit NEXT_PUBLIC_-Präfix:
SUPABASE_SECRET_KEY=
# Postgres-Admin-Verbindung NUR für Migrationen/Einrichtung (enthält DB-Passwort)
SUPABASE_DB_URL=
# Eingeschränkte Worker-Rolle – wird von `npm run db:setup-worker` automatisch gesetzt
FABRIC_WORKER_DB_URL=
